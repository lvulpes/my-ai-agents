# Default tool: goose or claude-code (one run: ./run.sh network-debugging --tool ...)
TOOL=goose
# Default model per tool (one run: --model ...)
# goose + OpenRouter: any `vendor/model` slug from openrouter.ai/models that supports tools
MODEL_GOOSE=openai/gpt-oss-120b
MODEL_CLAUDE_CODE=sonnet
# goose: provider that serves MODEL_GOOSE (openrouter or groq)
GOOSE_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Only needed with GOOSE_PROVIDER=groq
GROQ_API_KEY=
# goose: smart_approve (default) asks before risky commands; auto for unattended runs
GOOSE_MODE=smart_approve
# claude-code: leave empty to use the subscription login stored in state/.claude
ANTHROPIC_API_KEY=
# Optional: join an existing Docker network to reach the containers on it (e.g. a lab),
# in addition to the job's own network. Empty: no extra network.
# Value: the network NAME, from the NAME column of `docker network ls`, e.g. TARGET_NETWORK=mylab_default.
# Not a subnet (10.10.10.0/24), not an IP, not a container name or ID.
# Which network is a container on: docker inspect <container> --format '{{json .NetworkSettings.Networks}}'
# Start the containers that own the network first, or the run fails with "no Docker network".
TARGET_NETWORK=
