# Default tool: aider or claude-code (one run: ./run.sh code-architect --tool ...)
TOOL=aider
# Default model per tool (one run: --model ...)
# aider via OpenRouter: openrouter/<slug>, slugs from openrouter.ai/models
MODEL_AIDER=openrouter/google/gemini-3.1-pro-preview
MODEL_CLAUDE_CODE=opus
# aider architect mode: the model that writes the edits (no --model flag for this one)
EDITOR_MODEL_AIDER=openrouter/deepseek/deepseek-v3.2
# aider keys: only the providers named in the models above are needed.
# One OpenRouter key covers every openrouter/... model.
OPENROUTER_API_KEY=
# Without OpenRouter: MODEL_AIDER=gemini/gemini-3.1-pro-preview, EDITOR_MODEL_AIDER=groq/openai/gpt-oss-120b
GEMINI_ACADEMIC_CODE_KEY=
GROQ_API_KEY=
# claude-code: leave empty to use the subscription login stored in state/.claude
ANTHROPIC_API_KEY=
# Absolute path of the repo the agent works on (mounted read-write at /work)
WORKSPACE_DIR=
