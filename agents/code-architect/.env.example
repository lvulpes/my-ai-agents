# Default tool: aider or claude-code (one run: ./run.sh code-architect --tool ...)
TOOL=aider
# Default model per tool (one run: --model ...)
MODEL_AIDER=gemini/gemini-3.1-pro-preview
MODEL_CLAUDE_CODE=opus
# aider
GEMINI_ACADEMIC_CODE_KEY=
GROQ_API_KEY=
# claude-code: leave empty to use the subscription login stored in state/.claude
ANTHROPIC_API_KEY=
# Absolute path of the repo the agent works on (mounted read-write at /work)
WORKSPACE_DIR=
