# Default tool: aider or claude-code (one run: ./run.sh recipe --tool ...)
TOOL=aider
# Default model per tool (one run: --model ...)
MODEL_AIDER=gemini/gemini-3.8-flash
MODEL_CLAUDE_CODE=sonnet
# aider
GEMINI_RECIPE_API_KEY=
GROQ_API_KEY=
# claude-code: leave empty to use the subscription login stored in state/.claude
ANTHROPIC_API_KEY=
