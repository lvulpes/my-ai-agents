# Default tool: goose or claude-code (one run: ./run.sh literature-review --tool ...)
TOOL=goose
# Default model per tool (one run: --model ...)
# goose + OpenRouter: any `vendor/model` slug from openrouter.ai/models that supports tools
MODEL_GOOSE=openai/gpt-oss-120b
MODEL_CLAUDE_CODE=sonnet
# goose: provider that serves MODEL_GOOSE
GOOSE_PROVIDER=openrouter
OPENROUTER_API_KEY=
# claude-code: leave empty to use the subscription login stored in state/.claude
ANTHROPIC_API_KEY=
