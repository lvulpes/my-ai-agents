# Default tool: goose or aider (one run: ./run.sh network-forensics --tool ...)
TOOL=goose
# Default model per tool (one run: --model ...)
MODEL_GOOSE=openai/gpt-oss-120b
MODEL_AIDER=groq/openai/gpt-oss-120b
# goose: provider that serves MODEL_GOOSE
GOOSE_PROVIDER=groq
# Groq API key (used by both tools)
GROQ_API_KEY=
