# Default tool: goose or aider (one run: ./run.sh network-forensics --tool ...)
TOOL=goose
# Default model per tool (one run: --model ...)
# goose + OpenRouter: any `vendor/model` slug from openrouter.ai/models that supports tools
MODEL_GOOSE=openai/gpt-oss-120b
# aider via OpenRouter: openrouter/<slug>. Without OpenRouter: groq/openai/gpt-oss-120b
MODEL_AIDER=openrouter/openai/gpt-oss-120b
# goose: provider that serves MODEL_GOOSE (openrouter or groq)
GOOSE_PROVIDER=openrouter
# One OpenRouter key covers every OpenRouter model, for both tools
OPENROUTER_API_KEY=
# Only needed with GOOSE_PROVIDER=groq or a groq/... aider model
GROQ_API_KEY=
# goose: smart_approve (default) asks before risky commands; auto for unattended runs
GOOSE_MODE=smart_approve
